#!/usr/bin/env ruby

lib = File.expand_path("../lib/", __dir__)
$LOAD_PATH.unshift lib unless $LOAD_PATH.include?(lib)

require "micro-optparse"
require "cuco"

options = Parser.new do |p|
  p.banner = "Usage: cuco [options] [.watchr]"
  p.version = "cuco #{Cuco::VERSION}"
  p.option :debug, "Debugging output", default: false
end.process!

G.init(options, ARGV)

unless File.file?(G.scriptname) && File.readable?(G.scriptname)
  abort "Cuco: cannot read script: #{G.scriptname}"
end

begin
  Script.load(File.read(G.scriptname), G.scriptname)
rescue StandardError, SyntaxError => e
  abort "Cuco: #{e.class}: #{e.message}"
end

Controller.instance.run
